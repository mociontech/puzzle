# Evius Datahub. Estas variables viven SOLO en el servidor (Netlify > Site configuration > Environment variables).
# Nunca van en el navegador ni en el repositorio. Copia este archivo a .env solo para pruebas locales.

# Base del Datahub (termina en /datahub). Desarrollo: https://mocion-dev-62y2v.ondigitalocean.app/evius/api/datahub
EVIUS_URL=
# Token Bearer de un usuario administrador de Evius (caduca; renovarlo en Netlify cuando la consola diga "unauthorized")
EVIUS_TOKEN=
# Evento de Evius donde se registran asistentes y participaciones
EVIUS_EVENT_ID=
# ID de ESTA experiencia (puzzle) en Evius
EVIUS_EXPERIENCE_ID=
# Etiqueta de origen que Evius muestra para estos registros
EVIUS_SOURCE=
# Solo se envia a Evius cuando vale live. Cualquier otro valor (p. ej. off) descarta los registros sin enviarlos.
EVIUS_MODE=
# Score (0-100) que se envia por cada puzzle completado. Por defecto 100.
EVIUS_SCORE_PER_COMPLETION=
