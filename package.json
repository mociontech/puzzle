{
  "name": "puzzle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:trivia": "node --test tests/trivia.test.mjs",
    "evius:off": "node scripts/test-evius-function.mjs",
    "evius:ping": "node scripts/test-evius-function.mjs --ping",
    "evius:live": "node scripts/test-evius-function.mjs --live",
    "evius:trivia:off": "node scripts/test-evius-function.mjs --trivia",
    "evius:trivia:live": "node scripts/test-evius-function.mjs --live --trivia",
    "functions": "npx netlify-cli functions:serve --port 9999"
  },
  "dependencies": {
    "firebase": "^10.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-jigsaw-puzzle": "^1.0.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "vite": "^5.0.8"
  }
}
